# Окончания строк в репозитории — LF. Git нормализует текстовые файлы при добавлении
# и выдаёт их в рабочую копию с LF на любой ОС.
* text=auto eol=lf

# Двоичные файлы не преобразуются
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.pdf   binary
*.pptx  binary
*.docx  binary
*.xlsx  binary
*.zip   binary
